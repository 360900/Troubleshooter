pkgname=troubleshooter
pkgver=0.1.1
pkgrel=1
pkgdesc="Finds and fixes common Linux problems"
arch=(any)
url="https://github.com/360900/Troubleshooter"
license=(GPL-3.0-or-later)
depends=(python pyside6 polkit pciutils)
makedepends=(python-build python-installer python-setuptools python-wheel)
_root="$(realpath "$startdir/..")"

build() {
  # makepkg keeps src/ between runs, so an older wheel would be installed too.
  rm -rf "$srcdir/dist"
  python -m build --wheel --no-isolation --outdir "$srcdir/dist" "$_root"
}

package() {
  python -m installer --destdir="$pkgdir" "$srcdir"/dist/$pkgname-$pkgver-*.whl
  install -Dm644 "$_root/packaging/troubleshooter.desktop" -t "$pkgdir/usr/share/applications"
  install -Dm644 "$_root/troubleshooter/ui/assets/troubleshooter.svg" -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
}
